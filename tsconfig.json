{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "tests/repository/**/*.ts",
    "tests/support/**/*.ts"
  ],
  "exclude": [
    "examples/**",
    "studies/**",
    "tools/**",
    "tests/fixtures/script-suites/**",
    "tests/fixtures/authoring-api/drafts/**"
  ]
}
