import { test, expect } from "@playwright/test";

const BASE_URL = process.env.PLAYTEST_BASE_URL ?? "http://shop.test";

/** Playtest gate globs: `*` matches any run, `?` one character, anchored. */
function globToRegExp(glob: string): RegExp {
  const re = String(glob)
    .replace(/[.+^${}()|[\]\\]/g, "\\$&")
    .replace(/\*/g, ".*")
    .replace(/\?/g, ".");
  return new RegExp(`^${re}$`);
}

test("checkout", async ({ page, context }) => {
  // ---- session setup (mirrors the Playtest web driver) ----
  const requests: { method: string; path: string }[] = [];
  page.on("request", (r) => {
    let pathname = r.url();
    try {
      pathname = new URL(r.url()).pathname;
    } catch {}
    requests.push({ method: r.method(), path: pathname });
  });
  let consoleErrors = 0;
  page.on("console", (m) => {
    if (m.type() === "error") consoleErrors += 1;
  });
  page.on("pageerror", () => {
    consoleErrors += 1;
  });
  await context.addCookies([
    { name: "session", value: "abc123", url: BASE_URL },
    { name: "consent", value: "all", url: BASE_URL },
  ]);
  await page.goto(BASE_URL);

  // ---- the saved path ----

  // step 1 · type — The checkout form needs a name before it will let me continue, so I fill in the customer's name.
  await page.locator("[data-testid=\"name\"]").fill("Ada \"Lovelace\"");

  // step 2 · select — The story asks for the fastest option, so I choose Express from the shipping dropdown.
  if (await page.locator("#shipping").evaluate((el) => el.tagName) !== "SELECT") {
    await page.locator("#shipping").click();
  } else {
    await page.locator("#shipping")
      .selectOption({ label: "Express" })
      .catch(() => page.locator("#shipping").selectOption("Express"));
  }

  // step 3 · scroll — The order summary is cut off below the fold and I need to reach the totals, so I scroll the panel.
  if (!(await page.locator("[data-testid=\"summary\"]").evaluate((el, d) => {
    for (let n = el; n; n = n.parentElement) {
      if (n === document.documentElement || n === document.body) break;
      const s = getComputedStyle(n);
      const room = d > 0 ? n.scrollTop + n.clientHeight < n.scrollHeight - 1 : n.scrollTop > 0;
      if (n.scrollHeight - n.clientHeight > 1 && /(auto|scroll|overlay)/.test(s.overflowY) && room) {
        n.scrollBy(0, d);
        return true;
      }
    }
    return false;
  }, 600))) await page.mouse.wheel(0, 600);

  // step 4 · scroll — Nothing here is anchored to an element, so this scrolls the page itself back toward the form.
  // APPROXIMATE: the harness scrolls the topmost dialog / largest scrollable
  // element first (pickScrollTarget) and only falls back to the wheel.
  await page.mouse.wheel(0, -600);

  // step 5 · click — Everything the story asked for is filled in, so I place the order.
  await page.locator("role=button[name=\"Place order\"]").click();

  // step 6 · wait — The confirmation is still rendering after the POST, so I give it a moment.
  await page.waitForTimeout(1500);

  // step 7 · navigate — The banner links to the receipt, and the story ends on the receipt page.
  await page.goto(new URL("/order/receipt", BASE_URL).href);

  // step 8 · back — I want to confirm the confirmation page is still reachable behind the receipt.
  await page.goBack();

  // ---- success criteria (the gate) ----

  // url_matches: /order/receipt*
  const urlRe1 = globToRegExp("/order/receipt*");
  await expect
    .poll(() => {
      const url = page.url();
      let pathname: string | null = null;
      try {
        pathname = new URL(url).pathname;
      } catch {}
      return urlRe1.test(url) || (pathname !== null && urlRe1.test(pathname));
    })
    .toBe(true);

  // element_exists: [data-testid="receipt-total"]
  // (the receipt shows a total)
  await expect(page.locator("[data-testid=\"receipt-total\"]")).not.toHaveCount(0);

  // api_called: POST /api/orders
  const apiRe1 = globToRegExp("/api/orders");
  await expect
    .poll(() => requests.some((r) => r.method.toUpperCase() === "POST" && apiRe1.test(r.path)))
    .toBe(true);

  // console_errors: 0
  // Soft (advisory) in Playtest; HARD here — an exported spec has no soft tier.
  expect(consoleErrors).toBeLessThanOrEqual(0);

  // assert: the receipt names the "Analytical Engine" and the express shipping line
  // UNCHECKED — an LLM judges this in Playtest; there is no runtime equivalent.
  test.info().annotations.push({
    type: "playtest-assert",
    description: "the receipt names the \"Analytical Engine\" and the express shipping line",
  });

  // accessibility_violations: 0
  // NOT EXPORTED: Playtest counts WCAG violations per step with axe-core.
  // The closest Playwright equivalent is @axe-core/playwright, which you would
  // wire up yourself: expect((await new AxeBuilder({ page }).analyze()).violations)
  //   .toHaveLength(0);  // Playtest's budget: 0

  // NOT EXPORTED — perf budget over Playtest's own telemetry: perf.lcp_ms < 2500
});
